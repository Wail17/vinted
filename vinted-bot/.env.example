# Anthropic API key — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here

# Path to the Playwright saved session (cookies + storage)
SESSION_FILE=./session.json

# Vinted domain to use (vinted.be / vinted.fr / vinted.de / etc.)
VINTED_DOMAIN=vinted.be

# Proxy credentials (iProyal geo proxy — http://geo.iproyal.com:12321)
PROXY_USERNAME=
PROXY_PASSWORD=

# Set to true to dump a screenshot + full HTML of the inbox on every poll
# Saves to /tmp/inbox-debug.png and /tmp/inbox-debug.html
DEBUG_INBOX=true
